{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://upjqzuruxbvgdrheacnz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "agent-nexus",
      "version": "0.2.0",
      "title": "Agent Nexus"
    },
    "tools": [
      {
        "name": "discover_capabilities",
        "title": "Discover a callable interface for a need",
        "description": "Match a natural-language need (e.g. 'send a transactional email', 'query Postgres') to the interfaces that can do it, ranked by capability match and verified reliability. Returns everything needed to call them: endpoint, auth mode, auth parameters, formats, rate limit and cost.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "need": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "What the agent is trying to accomplish, in plain language."
            },
            "category": {
              "description": "Restrict to one interface layer.",
              "type": "string",
              "enum": [
                "api",
                "mcp",
                "cli"
              ]
            },
            "min_reliability": {
              "default": 0,
              "description": "Drop interfaces whose reliability score is below this value.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "limit": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "need"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "need": {
              "type": "string"
            },
            "count": {
              "type": "number"
            },
            "matches": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "need",
            "count",
            "matches"
          ]
        }
      },
      {
        "name": "list_categories",
        "title": "List interface categories",
        "description": "List the three interface layers Agent Nexus indexes (APIs, MCPs, CLIs) with the number of approved entries in each.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "categories": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "categories"
          ]
        }
      },
      {
        "name": "search_registry",
        "title": "Search registry",
        "description": "Search the Agent Nexus registry of approved APIs, MCP servers and CLIs by keyword and optional category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "default": "",
              "description": "Keyword matched against name, summary, endpoint or slug.",
              "type": "string",
              "maxLength": 120
            },
            "category": {
              "description": "Restrict results to one interface category.",
              "type": "string",
              "enum": [
                "api",
                "mcp",
                "cli"
              ]
            },
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "count": {
              "type": "number"
            },
            "results": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "count",
            "results"
          ]
        }
      },
      {
        "name": "get_entry",
        "title": "Get registry entry",
        "description": "Fetch one approved Agent Nexus registry entry by slug, including its endpoint, auth method and last health probe.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Entry slug, e.g. 'stripe-api'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "entry": {}
          },
          "required": [
            "entry"
          ]
        }
      },
      {
        "name": "submit_entry",
        "title": "Submit an interface to the registry",
        "description": "Submit an API, MCP server or CLI to Agent Nexus on behalf of the signed-in member. The entry lands in the moderation queue; describe its capabilities precisely so other agents can match it to a need.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "category": {
              "type": "string",
              "enum": [
                "api",
                "mcp",
                "cli"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300,
              "description": "One line: what it does."
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Base URL, MCP URL or command."
            },
            "auth_mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "e.g. 'Bearer API key', 'OAuth 2.1', 'none'."
            },
            "capabilities": {
              "default": [],
              "description": "Machine-matchable verbs, e.g. ['send-email','list-templates'].",
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              }
            },
            "auth_params": {
              "default": [],
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "description": "header | query | env | flag"
                  },
                  "required": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "location"
                ]
              }
            },
            "input_format": {
              "default": "",
              "type": "string",
              "maxLength": 120
            },
            "output_format": {
              "default": "",
              "type": "string",
              "maxLength": 120
            },
            "rate_limit": {
              "default": "",
              "type": "string",
              "maxLength": 120
            },
            "pricing": {
              "default": "",
              "type": "string",
              "maxLength": 120
            },
            "invocation_example": {
              "default": "",
              "type": "string",
              "maxLength": 1000
            },
            "docs_url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            },
            "tags": {
              "default": [],
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "description": {
              "default": "",
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "name",
            "category",
            "summary",
            "endpoint",
            "auth_mode"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "status"
          ]
        }
      },
      {
        "name": "vote_entry",
        "title": "Vote on a registry entry",
        "description": "Signal that an approved interface is useful, on behalf of the signed-in member. Calling it again removes the vote. One vote per member per entry.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Entry slug, e.g. 'resend-api'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "voted": {
              "type": "boolean"
            }
          },
          "required": [
            "slug",
            "voted"
          ]
        }
      },
      {
        "name": "list_my_submissions",
        "title": "List my submissions",
        "description": "List the interfaces the signed-in member submitted, with their moderation status and any reviewer note.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "count": {
              "type": "number"
            },
            "submissions": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "count",
            "submissions"
          ]
        }
      }
    ]
  }
}
