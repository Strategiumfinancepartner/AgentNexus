{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agent-nexus",
  "description": "Live health and tool-schema checks for 740+ remote MCP servers and APIs, so Copilot agents can verify a tool is up before calling it. Advisory only; no paid ranking.",
  "version": "1.1.4",
  "author": {
    "name": "Agent Nexus",
    "url": "https://agentnexus.app"
  },
  "homepage": "https://agentnexus.app",
  "repository": "https://github.com/Strategiumfinancepartner/AgentNexus",
  "license": "MIT",
  "keywords": [
    "mcp",
    "discovery",
    "observability",
    "registry",
    "apis",
    "tools"
  ],
  "extensions": {
    "com.github.copilot": {
      "mcpServers": {
        "agent-nexus": {
          "type": "streamable-http",
          "url": "https://agentnexus.app/api/public/mcp"
        }
      }
    }
  }
}
