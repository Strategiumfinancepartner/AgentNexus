{
  "name": "n8n-nodes-agentnexus",
  "version": "0.1.6",
  "description": "n8n node for Agent Nexus: find health-checked APIs, MCP servers and CLIs by plain-language need.",
  "keywords": [
    "n8n-community-node-package",
    "mcp",
    "api-registry",
    "ai-agents",
    "agent-nexus"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Strategiumfinancepartner/n8n-nodes-agentnexus",
  "author": {
    "name": "Agent Nexus",
    "email": "support@agentnexus.app",
    "url": "https://agentnexus.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Strategiumfinancepartner/n8n-nodes-agentnexus.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/AgentNexus/agentnexus.svg dist/nodes/AgentNexus/ && cp credentials/agentnexus.svg dist/credentials/",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AgentNexusApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AgentNexus/AgentNexus.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
